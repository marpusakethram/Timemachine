# The offline simulator requires none of these settings.
GEMINI_API_KEY=
GEMINI_MODEL=
# Exact model IDs you personally verified at https://ai.google.dev/gemini-api/docs/pricing
FREE_MODEL_ALLOWLIST=
# Set to today's YYYY-MM-DD after checking that page (expires after 30 days).
FREE_MODEL_VERIFIED_ON=
# Only use a project with billing disabled. No API can reliably verify this for you.
GEMINI_UNBILLED_PROJECT_CONFIRMED=false
GEMINI_DAILY_REQUEST_LIMIT=10
GEMINI_PER_RUN_LIMIT=3
GEMINI_MAX_OUTPUT_TOKENS=3000
# Local state for persistent quotas and deterministic response cache.
TIMEMACHINE_DATA_DIR=.data
